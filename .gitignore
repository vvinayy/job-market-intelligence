# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# Scrape output / operational logs — regenerated by jobmarket.bat,
# not source. naukri_jobs.json is the fallback dump written only when a
# database write fails mid-run.
logs/
naukri_jobs.json

# Secrets — never committed; DB credentials are read from environment
# variables only (see job_database.py / api/database.py), but this stays
# as a guard against anyone adding one later.
.env
.env.*
*.pem

# Saved browser session state (cookies/login) — e.g. Playwright's
# storage_state output. This is live account credentials, not a fixture;
# never belongs in git regardless of which site it's for.
.auth/

# Editor / tool-local config
.vscode/
.idea/
.claude/settings.local.json

# OS cruft
.DS_Store
Thumbs.db
